{
  "mode": "en_modern_2025",
  "task": "modernize",
  "description": "Modern English rewrite for 2025 audiences, eliminating archaic forms while preserving tone and character voice.",
  "rules": {
    "avoid_archaisms": true,
    "sentence_length_target": 10,
    "sentence_length_tolerance_pct": 5,
