    "preserve_dialogue": true,
    "avoid_redundancy": true,
    "avoid_passive_voice_excess": true,
    "preserve_narrative_rhythm": true,
    "preserve_emotional_intent": true
  },
  "output": {
    "format": "plain",
    "language": "en"
  }
}
