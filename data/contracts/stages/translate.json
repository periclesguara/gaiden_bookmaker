{
  "id": "translate",
  "version": "1.0.0",
  "stage_type": "llm_editorial_stage",
  "description": "Translates or modernizes source chunks into the target language/style contract while preserving meaning, structure, and narrative integrity.",
  "input_requirements": {
    "requires_chunk": true,
    "requires_language_contract": true,
    "requires_agent_contract": true,
    "requires_source_text": true
  },
  "output_requirements": {
    "plain_text_only": true,
    "preserve_headings": true,
    "normalize_heading_numbers": true,
    "preserve_paragraphs": true,
    "preserve_dialogue": true,
    "no_explanations": true,
    "no_notes": true,
    "no_json": true,
    "no_markdown_fences": true
  },
  "heading_policy": {
    "convert_roman_numerals_to_arabic": true,
    "applies_to": [
      "book headings",
      "chapter headings",
      "part headings",
      "section headings"
    ],
    "examples": {
      "BOOK I": "BOOK 1",
      "BOOK II": "BOOK 2",
      "BOOK X": "BOOK 10",
      "CHAPTER IV": "CHAPTER 4",
      "PART III": "PART 3",
      "SECTION VII": "SECTION 7"
    },
    "preserve_heading_meaning": true,
    "do_not_translate_heading_numbers_as_words": true,
    "do_not_leave_roman_numeral_headings": true
  },
  "mandatory_rules": [
    "Convert Roman numerals in structural headings to Arabic numerals.",
    "Preserve the heading label, but normalize its number.",
    "BOOK IV must become BOOK 4.",
    "CHAPTER IX must become CHAPTER 9.",
    "Do not leave structural headings with Roman numerals.",
    "Do not convert Roman numerals inside normal prose unless they are detected as headings."
  ],
  "processing_order": [
    "load_agent_contract",
    "load_language_contract",
    "load_stage_contract",
    "load_validator_contracts",
    "scan_input",
    "build_prompt",
    "call_openai_responses_api",
    "normalize_structural_heading_numerals",
    "validate_output",
    "retry_if_needed",
    "write_output",
    "write_audit_log"
  ],
  "failure_policy": {
    "empty_output": "fail",
    "roman_heading_numerals_remaining": "retry",
    "meta_commentary_detected": "retry",
    "heading_loss": "retry",
    "max_retries_exceeded": "fail_and_save_report"
  }
}
