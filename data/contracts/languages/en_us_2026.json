{
  "id": "en_us_2026",
  "version": "1.0.0",
  "language": "English",
  "locale": "United States",
  "target_year": 2026,
  "orthography": {
    "spelling": "american",
    "punctuation": "american",
    "quotation_marks": "american_double_quotes",
    "serial_comma": true
  },
  "modernization_policy": {
    "remove_archaisms": true,
    "remove_obsolete_pronouns": true,
    "remove_obsolete_verb_forms": true,
    "remove_obsolete_idioms": true,
    "remove_stiff_victorian_syntax": true,
    "preserve_literary_atmosphere": true,
    "preserve_historical_context": true,
    "target_reader": "general educated American reader in 2026"
  },
  "archaic_terms_policy": {
    "mode": "contextual_rewrite",
    "do_not_use_blind_regex_replacement": true,
    "forbidden_terms": [
      "thou",
      "thee",
      "thy",
      "thine",
      "ye",
      "hath",
      "doth",
      "dost",
      "shalt",
      "wilt",
      "wouldst",
      "couldst",
      "shouldst",
      "wert",
      "whilst",
      "amongst",
      "ere",
      "nay",
      "hither",
      "thither",
      "whither",
      "wherefore",
      "methinks",
      "perchance",
      "naught",
      "aught",
      "anon",
      "oft",
      "tis",
      "twas"
    ],
    "forbidden_phrases": [
      "art thou",
      "wert thou",
      "dost thou",
      "hast thou",
      "wouldst thou",
      "couldst thou",
      "shouldst thou"
    ],
    "preferred_rewrites": {
      "thou": "you",
      "thee": "you",
      "thy": "your",
      "thine": "yours",
      "ye": "you",
      "hath": "has",
      "doth": "does",
      "dost": "do",
      "shalt": "will",
      "wilt": "will",
      "wouldst": "would",
      "couldst": "could",
      "shouldst": "should",
      "wert": "were",
      "whilst": "while",
      "amongst": "among",
      "ere": "before",
      "nay": "no",
      "hither": "here",
      "thither": "there",
      "whither": "where",
      "wherefore": "why",
      "methinks": "I think / it seems",
      "perchance": "perhaps",
      "naught": "nothing",
      "aught": "anything",
      "anon": "soon",
      "oft": "often",
      "tis": "it is",
      "twas": "it was"
    }
  },
  "syntax_policy": {
    "rewrite_inversions": true,
    "modernize_clause_order": true,
    "reduce_overlong_sentences_when_needed": true,
    "preserve_rhythm_when_possible": true,
    "avoid_excessive_semicolon_chains": true
  },
  "style_policy": {
    "target_style": "modern premium literary American English",
    "avoid_slang": true,
    "avoid_academic_stiffness": true,
    "avoid_simplistic_prose": true,
    "avoid_over_modern_pop_culture_language": true,
    "preserve_formality_when_context_requires": true
  }
}
