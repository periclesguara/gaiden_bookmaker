{
  "version": "1.0.0",
  "default_provider": "openai",
  "default_api": "responses",
  "agents": [
    {
      "id": "modernize_en_us_2026",
      "stage": "modernize",
      "language": "en_us",
      "contract_path": "data/contracts/agents/modernize_en_us_2026.agent.json",
      "enabled": true,
      "default": true
    },
    {
      "id": "refine_en_us_2026",
      "stage": "refine",
      "language": "en_us",
      "contract_path": "data/contracts/agents/refine_en_us_2026.agent.json",
      "enabled": true,
      "default": true
    },
    {
      "id": "polish_en_us_aristotle_2026",
      "stage": "polish",
      "language": "en_us",
      "contract_path": "data/contracts/agents/polish_en_us_aristotle_2026.agent.json",
      "enabled": true,
      "default": true
    }
  ],
  "resolution_rules": [
    {
      "when": {
        "ui_stage": "translate",
        "target_language": "en_us"
      },
      "resolve_to": {
        "stage": "modernize",
        "language": "en_us",
        "agent_id": "modernize_en_us_2026"
      }
    },
    {
      "when": {
        "ui_stage": "refine",
        "target_language": "en_us"
      },
      "resolve_to": {
        "stage": "refine",
        "language": "en_us",
        "agent_id": "refine_en_us_2026"
      }
    },
    {
      "when": {
        "ui_stage": "polish",
        "target_language": "en_us"
      },
      "resolve_to": {
        "stage": "polish",
        "language": "en_us",
        "agent_id": "polish_en_us_aristotle_2026"
      }
    },
    {
      "when": {
        "stage": "modernize",
        "language": "en_us"
      },
      "use_agent": "modernize_en_us_2026"
    },
    {
      "when": {
        "stage": "refine",
        "language": "en_us"
      },
      "use_agent": "refine_en_us_2026"
    },
    {
      "when": {
        "stage": "polish",
        "language": "en_us"
      },
      "use_agent": "polish_en_us_aristotle_2026"
    }
  ]
}
