# Shared safe placeholders. Never commit a populated .env file.
DJANGO_SECRET_KEY=replace-with-a-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SECURE_SSL_REDIRECT=0

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=gaiden
PGUSER=gaiden
PGPASSWORD=replace-me

# Gaiden Bookmaker only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GAIDEN_DRIVE_REMOTE=gaiden_drive
WRITER_APP_URL=http://127.0.0.1:8001/

# Intake Normalize uses its own local-Qwen client and never imports Writer code.
GAIDEN_NORMALIZE_QWEN_BASE_URL=http://127.0.0.1:8000/v1
GAIDEN_NORMALIZE_QWEN_API_KEY=placeholder
GAIDEN_NORMALIZE_QWEN_MODEL=Qwen/Qwen3.5-9B
GAIDEN_NORMALIZE_BOUNDARY_LINES=180
GAIDEN_NORMALIZE_MIN_CONFIDENCE=0.80
GAIDEN_NORMALIZE_MAX_REMOVED_RATIO=0.35

# Independent Writer portal. WRITER_PG* can point at a separate database later.
WRITER_DJANGO_SECRET_KEY=replace-with-a-random-value
WRITER_DJANGO_DEBUG=0
WRITER_DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
WRITER_PGDATABASE=gaiden
WRITER_PGUSER=gaiden
WRITER_PGPASSWORD=replace-me
WRITER_PGHOST=127.0.0.1
WRITER_PGPORT=5432
GAIDEN_BOOKMAKER_URL=http://127.0.0.1:8000/

# Writer uses local OpenAI-compatible Qwen services, never an OpenAI cloud translation flow.
WRITER_QWEN_BASE_URL=http://127.0.0.1:8000/v1
WRITER_QWEN_API_KEY=placeholder
WRITER_QWEN_MODEL=Qwen/Qwen3.5-9B
WRITER_QWEN_THINKING=0
WRITER_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
WRITER_EMBEDDING_API_KEY=placeholder
WRITER_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Shared canonical sources are read-only; Writer artifacts and handoffs are external.
WRITER_SOURCE_ROOT=/srv/rinobooks/canonical-sources
WRITER_STORAGE_ROOT=/srv/rinobooks/writer
WRITER_HANDOFF_ROOT=/srv/rinobooks/google-drive/writer-handoff
