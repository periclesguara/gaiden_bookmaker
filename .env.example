# Copy this file to a local .env file and replace placeholders.
# Never commit the resulting .env file.
DJANGO_SECRET_KEY=replace-with-a-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SECURE_SSL_REDIRECT=0

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=gaiden
PGUSER=gaiden
PGPASSWORD=replace-me

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GAIDEN_DRIVE_REMOTE=gaiden_drive

# RinoBooks draft receiver. Keep the project-scoped token in local secrets only.
RINOBOOKS_PUBLISH_URL=https://rinobooks.example.invalid
RINOBOOKS_PUBLISH_TOKEN=

# Local Writer model endpoints. Placeholder keys are accepted only on loopback.
GAIDEN_QWEN_BASE_URL=http://127.0.0.1:8000/v1
GAIDEN_QWEN_API_KEY=placeholder
GAIDEN_QWEN_MODEL=Qwen/Qwen3.5-9B
GAIDEN_QWEN_THINKING=0
GAIDEN_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
GAIDEN_EMBEDDING_API_KEY=placeholder
GAIDEN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Writer source discovery and derived runtime artifacts (keep outside Git).
GAIDEN_WRITER_SOURCE_ROOT=/srv/gaiden/corpora
GAIDEN_WRITER_STORAGE_ROOT=/srv/gaiden/writer
