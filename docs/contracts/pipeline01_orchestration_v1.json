{
  "name": "pipeline01_orchestration_v1",
  "version": 1,
  "steps": [
    {
      "n": 1,
      "key": "normalize",
      "title": "Normalize",
      "outputs": [
        "data/normalized/{book}_{lang}_v2.txt"
      ]
    },
    {
      "n": 2,
      "key": "heading_cleaner",
      "title": "HeadingCleaner (Mechanical)",
      "outputs": [
        "data/chunks/{book}/heading_cleaner/clean.txt",
        "data/chunks/{book}/heading_cleaner/heading_cleaner_report.json"
      ]
    },
    {
      "n": 3,
      "key": "chunk",
      "title": "Split/Chunk",
      "outputs": [
        "data/chunks/{book}/split_01/*.txt"
      ]
    },
    {
      "n": 4,
      "key": "translate",
      "title": "Translate (script + JSON)",
      "contract_path": "gaiden/contracts/{contract}.json",
      "outputs": [
        "data/translated/{book}/{lang_variant}/*.txt",
        "data/builds/{book}/{lang}/merge_translate.txt"
      ]
    },
    {
      "n": 5,
      "key": "refine",
      "title": "Refine (Aldebaran)",
      "outputs": [
        "data/translated/{book}/{lang_variant}/return_aldebaran/*.txt",
        "data/builds/{book}/{lang}/merge_refine.txt"
      ]
    },
    {
      "n": 6,
      "key": "merge_refine",
      "title": "Merge/Finalize",
      "outputs": [
        "data/translated/{book}/merge_refine_clean.txt"
      ]
    }
  ],
  "invariants": [
    "heading_cleaner is a fixed mechanical step after normalize",
    "split_chunk runs only after heading_cleaner and consumes heading_cleaner/clean.txt",
    "translate requires heading_cleaner output plus fresh split_01 chunks",
    "rechunk invalidates stale downstream translate refine and merge artifacts",
    "refine runtime contract must expose hardened system_prompt and user_prompt rules before execution"
  ]
}
