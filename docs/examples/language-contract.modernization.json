{
  "schema_version": 1,
  "source_language": "en-GB",
  "target_language": "en-GB",
  "target_variant": "Contemporary British literary English",
  "operation": "modernize",
  "preserve": [
    "meaning",
    "proper_names",
    "plot_facts",
    "chronology",
    "point_of_view",
    "dialogue_intent",
    "period_atmosphere"
  ],
  "deleted_terms": [],
  "forbidden_terms": [
    "very unique"
  ],
  "replacements": {
    "ejaculated": "said",
    "connexion": "connection",
    "to-day": "today",
    "to-morrow": "tomorrow"
  },
  "style": {
    "reduce_archaisms": "moderate",
    "fluency": "literary",
    "avoid_repetition": true,
    "preserve_authorial_voice": true
  },
  "constraints": {
    "no_summary": true,
    "no_commentary": true,
    "no_new_facts": true
  },
  "validation": {
    "reject_forbidden_terms": true,
    "max_word_variation_percent": 20,
    "retry_attempts": 1
  }
}
